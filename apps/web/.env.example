# Where the cached road network and simulation logs are written (default: apps/web/.data)
# DATA_DIR=./.data

# Override OpenStreetMap endpoints (e.g. a private Overpass instance)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Skip the Nominatim lookup by giving the OSM relation id of the city boundary
# OSM_RELATION_ID=
