# Express API (apps/api) that runs simulations and stores the simulation log.
# Browser calls go to NEXT_PUBLIC_API_URL; it is inlined at build time, so rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional: different origin for server-side calls (e.g. http://api:3001 inside Docker)
# API_URL=

# Mapbox public token (pk.*) for the basemap; falls back to OpenStreetMap tiles when unset.
# Put the real value in .env.local (gitignored), not here. Inlined at build time, so restart/rebuild after changing it.
NEXT_PUBLIC_MAPBOX_TOKEN=
