# Copy to .env and fill in. Only DATABASE_URL is needed to run the API locally.

# PostgreSQL connection used by Prisma (replaces MONGO_URI / MONGO_DB)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wcro?schema=public"

PORT=3001
# NODE_ENV=production enables the rate limiter
# NODE_ENV=development
# Allowed browser origin for HTTP and Socket.IO (the Next.js app)
CORS_ORIGIN=http://localhost:3000
# Requests per IP per 15 min when NODE_ENV=production
# RATE_LIMIT=100
# Max request body (route files)
# BODY_LIMIT=5mb

# Road network download from OpenStreetMap (defaults are the public endpoints)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Skip the Nominatim lookup by giving the OSM relation id of the city boundary
# OSM_RELATION_ID=

# Auth (valid-session.middleware)
SECRET_KEY=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
SERVICE_ACCOUNT=

# Redis (optional: leave REDIS_HOST empty to run without it)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Mailer
MAILER_TRANSPORT_HOST=
MAILER_TRANSPORT_PORT=465
MAILER_TRANSPORT_SECURE=true
MAILER_EMAIL=
MAILER_PASSWORD=
MAILER_FROM_NAME="Waste Route Optimizer"
