{
  "name": "@wcro/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:import-legacy": "tsx scripts/import-legacy-data.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@wcro/core": "workspace:*",
    "@wcro/metrics": "workspace:*",
    "@wcro/road-network": "workspace:*",
    "@wcro/routing": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^18.0.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.0",
    "pg": "^8.23.0",
    "redis": "^6.3.0",
    "socket.io": "^4.8.0",
    "winston": "^3.17.0",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.0",
    "prisma": "^7.10.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
