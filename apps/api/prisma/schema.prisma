// Replaces the MongoDB collections of the api-template.
// After editing this file run `pnpm --filter @wcro/api db:migrate`.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

/// One archived simulation run.
/// The summary columns feed the history list without loading `result`.
model Simulation {
  /// Notebook format YYYYMMDD_HHMMSS plus a random suffix, e.g. 20261006_155856_5kla
  id                     String   @id
  createdAt              DateTime @map("created_at")
  routeName              String   @map("route_name")
  studyArea              String   @map("study_area")
  collectionPoints       Int      @map("collection_points")
  solver                 String?
  traditionalKm          Float    @map("traditional_km")
  optimizedKm            Float    @map("optimized_km")
  distanceSavingsPercent Float    @map("distance_savings_percent")
  /// Runs started from the Tests page ("Test all"). Only these can be deleted from the history.
  isTest                 Boolean  @default(false) @map("is_test")
  /// Full SimulationResult from @wcro/core
  result                 Json

  @@index([createdAt(sort: Desc)])
  @@map("simulations")
}

/// Was the capped `logs` collection written by winston-mongodb.
model Log {
  id        BigInt   @id @default(autoincrement())
  level     String
  message   String
  meta      Json?
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@map("logs")
}
